<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} — Лента</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="phone">
    <div class="page-content">
      {{#if data.vector}}
        <div class="feed-screen">
          <video
            class="feed-video"
            src="/media/{{data.vector.videoKey}}"
            poster="/media/{{data.vector.imageKey}}"
            autoplay
            muted
            loop
            playsinline
          ></video>

          <div class="feed-overlay">
            <div class="feed-bottom-row">
              <div class="feed-desc-block">
                <span class="feed-category">{{data.vector.category}}</span>
                <div class="feed-title">{{data.vector.title}}</div>

                <input type="checkbox" id="desc-toggle" class="desc-toggle-checkbox">
                <div class="feed-desc-text">{{data.vector.description}}</div>
                <label for="desc-toggle" class="desc-toggle-label">больше / меньше</label>
              </div>

              <div class="feed-side-actions">
                <div class="feed-field">
                  Опасность<br><b>{{data.vector.severity}} / 10</b>
                </div>
                <div class="feed-field">
                  Год фиксации<br><b>{{data.vector.discoveredYear}}</b>
                </div>
                <div class="like-badge">
                  <span class="heart">♥</span>
                  {{data.likesCount}}
                </div>
                <a class="next-btn" href="/feed/{{data.vector.id}}?next=true" title="Следующая услуга">›</a>
              </div>
            </div>
          </div>
        </div>
      {{else}}
        <div class="feed-empty">Услуга не найдена или не опубликована.</div>
      {{/if}}
    </div>

    {{> tabbar isFeed=data.isFeed }}
  </div>
</body>
</html>
