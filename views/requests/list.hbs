<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main>
    {{> header }}
    <section class="content">
      <h1>Заявки на оценку риска</h1>

      <form action="/requests" method="POST" class="search-form">
        <input type="text" name="query" placeholder="Поиск по названию системы" value="{{data.query}}">
        <button type="submit">Найти</button>
      </form>

      <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>№</th>
            <th>Система</th>
            <th>Дата</th>
            <th>Статус</th>
            <th>Защищённость</th>
            <th>Уровень риска</th>
          </tr>
        </thead>
        <tbody>
          {{#each data.requests}}
            <tr>
              <td><a href="/requests/{{this.id}}">{{this.id}}</a></td>
              <td><a href="/requests/{{this.id}}">{{this.systemName}}</a></td>
              <td>{{this.createdDate}}</td>
              <td>{{this.status}}</td>
              <td>{{this.protectionLevel}}%</td>
              <td class="risk-{{this.riskLevel}}">{{this.riskLevel}}</td>
            </tr>
          {{else}}
            <tr><td colspan="6">Ничего не найдено.</td></tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    </section>
    {{> footer }}
  </main>
</body>
</html>
