<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main>
    {{> header }}
    <section class="content">
      {{#if data.request}}
        <a href="/requests" class="back-link">&larr; К списку заявок</a>
        <h1>Заявка №{{data.request.id}}: {{data.request.systemName}}</h1>
        <p><strong>Дата создания:</strong> {{data.request.createdDate}}</p>
        <p><strong>Статус:</strong> {{data.request.status}}</p>
        <p><strong>Средний уровень защищённости мерами:</strong> {{data.request.protectionLevel}}%</p>
        <p><strong>Итоговый уровень риска:</strong>
          <span class="risk-{{data.request.riskLevel}}">{{data.request.riskLevel}}</span>
        </p>

        <h2>Выбранные векторы атак</h2>
        <div class="card-grid">
          {{#each data.vectors}}
            <div class="card">
              <h3><a href="/vectors/{{this.id}}">{{this.title}}</a></h3>
              <p class="badge">{{this.category}}</p>
              <p><strong>Базовая опасность:</strong> {{this.baseSeverity}} / 10</p>
            </div>
          {{else}}
            <p>Векторы атак не выбраны.</p>
          {{/each}}
        </div>
      {{else}}
        <p>Заявка не найдена.</p>
        <a href="/requests" class="back-link">&larr; К списку заявок</a>
      {{/if}}
    </section>
    {{> footer }}
  </main>
</body>
</html>
