<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="phone">
    <div class="page-content">
      <div class="tiles-page">
        <h1>Векторы атак</h1>

        <form class="filter-form" action="/" method="GET">
          <input
            type="date"
            name="discoveredDate"
            value="{{data.discoveredDate}}"
          >
          <button type="submit">Найти</button>
        </form>

        <div class="tile-grid">
          {{#each data.vectors}}
            <div class="tile-card-wrap">
              <a class="tile-card" href="/feed/{{this.id}}">
                <div class="tile-image-wrap">
                  <img src="/media/{{this.imageUrl}}" alt="{{this.title}}">
                </div>
                <div class="tile-info">
                  <p class="tile-title">{{this.title}}</p>
                  <div class="tile-likes"><span class="heart">♥</span> {{this.likesCount}}</div>
                </div>
              </a>
              <form action="/delete" method="POST" class="tile-delete-form">
                <input type="hidden" name="id" value="{{this.id}}">
                <button type="submit" class="tile-delete-btn" title="Удалить услугу">✕</button>
              </form>
            </div>
          {{else}}
            <p class="tiles-empty">Ничего не найдено на выбранный год.</p>
          {{/each}}
        </div>
      </div>
    </div>

    {{> tabbar isTiles=data.isTiles }}
  </div>
</body>
</html>
